# Copy this file to .env.local and replace the placeholders with your own Supabase project values.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Local Spring Boot API. The profile page stays on direct Supabase access by default.
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_USE_SPRING_API=false
