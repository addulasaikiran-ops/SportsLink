# Copy this file to .env.local and replace placeholders with your own values.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Local Spring Boot API. The profile page stays on direct Supabase access by default.
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_USE_SPRING_API=false

# Nexconn Chat: App Key is public; App Secret must stay server-only.
NEXT_PUBLIC_NEXCONN_APP_KEY=your-nexconn-app-key
NEXCONN_APP_SECRET=your-nexconn-app-secret

# Must match the data-center region selected for your Nexconn app:
# Singapore: https://api.sg-light-api.com
# North America: https://api.us-light-api.com
# Saudi Arabia: https://api.sau-light-api.com
NEXCONN_API_BASE_URL=https://api.sg-light-api.com
