# Copy this file to .env.local and replace placeholders with your own values.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Local Spring Boot API. The profile page stays on direct Supabase access by default.
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_USE_SPRING_API=false

# Nexconn Chat: the app key is public; secrets must remain server-only.
NEXT_PUBLIC_NEXCONN_APP_KEY=your-nexconn-app-key
NEXCONN_TOKEN_ENDPOINT=https://your-trusted-backend.example.com/api/nexconn/token
NEXCONN_SERVER_SECRET=replace-with-server-only-shared-secret
